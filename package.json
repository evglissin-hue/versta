{
  "name": "versta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/app_manifest.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "android:sync": "npm run build && rm -f dist/sw.js dist/workbox-*.js dist/registerSW.js && find dist -name '*.map' -delete && cp dist/app/index.html dist/index.html && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/newsreader": "^5.1.0",
    "@preact/signals": "^1.3.0",
    "maplibre-gl": "^4.7.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@preact/preset-vite": "^2.9.1",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
